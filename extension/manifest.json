{
  "manifest_version": 3,
  "name": "自动标签页分组",
  "description": "按网站标识自动整理新打开的网页标签页。",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "整理当前窗口",
    "default_popup": "popup.html"
  }
}
